# ==========================================
# InterviewPrep AI - Environment Configuration
# ==========================================

# Database (PostgreSQL + pgvector)
DATABASE_URL=jdbc:postgresql://localhost:5432/interviewprep_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_pass

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379

# Backend Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
JWT_SECRET=super_secret_jwt_key_that_is_at_least_256_bits_long_for_hmac_sha256_security_production
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# AI Provider (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage
FILE_STORAGE_PATH=./uploads/resumes

# Docker Sandbox Code Execution
DOCKER_ENABLED=true
CODE_EXECUTION_TIMEOUT=10000

# Frontend Next.js Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
